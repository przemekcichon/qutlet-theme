{
    "name": "qutlet/qutlet-theme",
    "description": "Qutlet Theme — warstwa graficzna (motyw blokowy). Renderuje dane z qutlet-core.",
    "type": "wordpress-theme",
    "license": "proprietary",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "php-stubs/woocommerce-stubs": "^10.9",
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Qutlet\\Theme\\": "inc/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse"
    }
}
