# PHPStan dla qutlet-theme (D-G2). Poziom startowy 5 — podnosimy osobnym punktem,
# gdy będzie realny kod do analizy. Stuby WordPressa dostarcza rozszerzenie
# szepeviktor/phpstan-wordpress (ładowane poniżej). Analizujemy kod imperatywny
# motywu (functions.php + inc/ — w tym inc/features/Blog/blocks/*/render.php,
# P-11.3: bloki dynamiczne bloga, patrz nagłówek inc/features/Blog/Blocks.php)
# ORAZ header.php/footer.php (klasyczny chrome renderujący parts/header.html/
# footer.html przez block_header_area()/block_footer_area() — współdzielony
# przez WSZYSTKIE klasyczne szablony, w tym page-*.php niżej) ORAZ
# template-parts/ (m.in. template-parts/blog/post-card.php, reużywany zarówno
# przez klasyczny kod jak i blok `qutlet/post-card`) ORAZ klasyczne szablony
# stron pomocy (P-8.5: page-pomoc.php i pozostałe page-*.php — hierarchia
# plików WP, patrz inc/features/Help/Help.php; blog — P-8.4 — od P-11.3
# przeszedł na blokowe templates/*.html, patrz nagłówek inc/features/Blog/Blog.php)
# ORAZ block patterns (P-11.1: patterns/*.php — te same wywołania i18n/escaping
# co page-*.php, tylko odkrywane auto-discovery WP zamiast hierarchii szablonów)
# — to REALNY kod z logiką, nie deklaratywna powierzchnia jak
# theme.json/templates/*.html/block.json (te faktycznie nie są PHP i zostają
# poza analizą).
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - functions.php
        - inc/
        - header.php
        - footer.php
        - template-parts/
        - page-pomoc.php
        - page-jak-to-dziala.php
        - page-kontakt.php
        - page-newsletter.php
        - page-regulamin.php
        - page-polityka-prywatnosci.php
        - page-polityka-cookies.php
        - patterns/
    excludePaths:
        - vendor/
    # Stuby WooCommerce — twarda zależność motywu (D-G5: theme → Woo + core).
    # Dają realne typowanie (`WC_Product`, `WC_Product_Attribute`,
    # `wc_get_product_terms`, `wc_attribute_label`) zamiast ignorowania błędów
    # (P-8.2c, ProductPage::specification_rows()).
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    # qutlet-core NIE jest paczką Composera (brak wpisu Packagist) — to realny
    # kod siostrzanego pluginu, obecny w tym samym Local (multi-root, patrz
    # CLAUDE.md → „Struktura multi-root"), więc typujemy go przez ścieżkę
    # względną zamiast stuba. Pierwsze bezpośrednie odwołanie theme → klasa
    # core (P-8.3b, D-8.3b.2 — `ProductFilters` woła
    # `Qutlet\Core\ProductFilters\ProductFilterQuery`). ZAŁOŻENIE: repo
    # qutlet-core wyewidencjowane obok qutlet-theme w tym samym wp-content —
    # jeśli kiedyś dojdzie CI budujące samo qutlet-theme bez sąsiadów, ta
    # ścieżka przestanie istnieć i PHPStan wróci do błędu `class.notFound`.
    scanDirectories:
        - ../../plugins/qutlet-core/src
