# PHPStan dla qutlet-theme (D-G2). Poziom startowy 5 — podnosimy osobnym punktem,
# gdy będzie realny kod do analizy. Stuby WordPressa dostarcza rozszerzenie
# szepeviktor/phpstan-wordpress (ładowane poniżej). Analizujemy kod imperatywny
# motywu (functions.php + inc/) ORAZ klasyczne szablony PHP bloga (P-8.4:
# home.php/single.php/category.php/tag.php/header.php/footer.php +
# template-parts/ — patrz nagłówek inc/features/Blog/Blog.php po uzasadnienie,
# czemu blog NIE stoi na blokowych `templates/*.html`) — to REALNY kod z
# logiką, nie deklaratywna powierzchnia jak theme.json/templates/*.html
# (te faktycznie nie są PHP i zostają poza analizą).
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - functions.php
        - inc/
        - home.php
        - single.php
        - category.php
        - tag.php
        - header.php
        - footer.php
        - template-parts/
    excludePaths:
        - vendor/
    # Stuby WooCommerce — twarda zależność motywu (D-G5: theme → Woo + core).
    # Dają realne typowanie (`WC_Product`, `WC_Product_Attribute`,
    # `wc_get_product_terms`, `wc_attribute_label`) zamiast ignorowania błędów
    # (P-8.2c, ProductPage::specification_rows()).
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    # qutlet-core NIE jest paczką Composera (brak wpisu Packagist) — to realny
    # kod siostrzanego pluginu, obecny w tym samym Local (multi-root, patrz
    # CLAUDE.md → „Struktura multi-root"), więc typujemy go przez ścieżkę
    # względną zamiast stuba. Pierwsze bezpośrednie odwołanie theme → klasa
    # core (P-8.3b, D-8.3b.2 — `ProductFilters` woła
    # `Qutlet\Core\ProductFilters\ProductFilterQuery`). ZAŁOŻENIE: repo
    # qutlet-core wyewidencjowane obok qutlet-theme w tym samym wp-content —
    # jeśli kiedyś dojdzie CI budujące samo qutlet-theme bez sąsiadów, ta
    # ścieżka przestanie istnieć i PHPStan wróci do błędu `class.notFound`.
    scanDirectories:
        - ../../plugins/qutlet-core/src
